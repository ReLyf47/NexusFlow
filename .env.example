# ==========================================
# NEXUSFLOW ENVIRONMENT CONFIGURATION
# ==========================================

# MariaDB Database Configuration (Docker / Local)
DB_HOST=localhost
DB_PORT=3306
DB_USER=nexus_user
DB_PASSWORD=nexus_pass_secret
DB_NAME=nexusflow_db
DB_ROOT_PASSWORD=nexus_root_secret

# Drizzle ORM Database Connection URL (Driver: mysql2) — used by drizzle-kit
DATABASE_URL=mysql://nexus_user:nexus_pass_secret@localhost:3306/nexusflow_db

# JWT signing + LLM API-key encryption secret. REQUIRED in production.
# Generate one with: openssl rand -base64 32
AUTH_SECRET=

# Default local Ollama engine (each workspace Admin can override provider/URL/model)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3:latest

# App URL & Node Environment
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
